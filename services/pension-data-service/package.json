{
  "name": "pension-data-service",
  "version": "0.1.0",
  "private": true,
  "description": "HIV Pension Portal: Excel/CSV imports (stage, validate, preview, commit) and exports",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "start:dev": "nodemon --watch src --ext ts --exec \"node --env-file-if-exists=../../env/local.env -r ts-node/register src/index.ts\"",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "migration:run": "node --env-file-if-exists=../../env/local.env -r ts-node/register src/dev/migrate.ts run",
    "migration:revert": "node --env-file-if-exists=../../env/local.env -r ts-node/register src/dev/migrate.ts revert",
    "migration:show": "node --env-file-if-exists=../../env/local.env -r ts-node/register src/dev/migrate.ts show",
    "seed": "node -e \"console.log('data-service: nothing to seed')\"",
    "purge": "node --env-file-if-exists=../../env/local.env -r ts-node/register src/dev/purge-staged.ts",
    "fixture:soch": "node -r ts-node/register src/dev/make-soch-fixture.ts"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.5",
    "morgan": "^1.11.0",
    "multer": "^2.4.0",
    "papaparse": "^5.5.3",
    "pg": "^8.20.0",
    "rate-limit-redis": "^6.0.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.29",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
