# HIV Pension Portal: LOCAL profile, shared by the 3 services, the web app and docker-compose.
#
# Do not edit env/local.env by hand for secrets: run scripts/setup.sh, which copies this file to
# env/local.env and replaces every __GENERATE__ with a fresh random value.
# env/local.env is gitignored. NEVER commit it, paste it in chat, or copy it to another machine.
#
# Every key is validated at boot by the service's src/config/index.ts (zod). A missing or malformed
# value stops the service with a message naming the key.

# ---------------------------------------------------------------- profile
# local | uat | production. Several safety switches below are only accepted when APP_ENV=local.
APP_ENV=local
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Kolkata

# ---------------------------------------------------------------- ports and URLs
WEB_PORT=3200
AUTH_SERVICE_PORT=3201
CORE_SERVICE_PORT=3202
DATA_SERVICE_PORT=3203
AUTH_SERVICE_URL=http://127.0.0.1:3201
CORE_SERVICE_URL=http://127.0.0.1:3202
DATA_SERVICE_URL=http://127.0.0.1:3203
WEB_ORIGIN=http://localhost:3200
# Comma list of browser origins allowed to call the services directly. Never "*".
CORS_ORIGIN=http://localhost:3200
# Number of proxies in front of a service. Locally the BFF is the one hop. Never "true".
TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------- Postgres (docker-compose)
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=hiv_pension
DB_POOL_MAX=10
# Superuser, used only by docker-compose to create the database. Services never use it.
DB_ADMIN_USER=pension_admin
DB_ADMIN_PASSWORD=__GENERATE__
# One login role per service (docker/postgres/10-bootstrap.sh). Each owns only its own schema.
AUTH_DB_USER=pension_auth_svc
AUTH_DB_PASSWORD=__GENERATE__
CORE_DB_USER=pension_core_svc
CORE_DB_PASSWORD=__GENERATE__
DATA_DB_USER=pension_data_svc
DATA_DB_PASSWORD=__GENERATE__
# Migration and seed scripts refuse to run unless this is true.
DB_ALLOW_MIGRATIONS=true

# ---------------------------------------------------------------- Redis (docker-compose)
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=__GENERATE__

# ---------------------------------------------------------------- MinIO (docker-compose)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=19010
MINIO_CONSOLE_PORT=19011
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=pensionminio
MINIO_SECRET_KEY=__GENERATE__
MINIO_BUCKET=hiv-pension-private

# ---------------------------------------------------------------- tokens and encryption keys
# Shared by every service. Rotating any of them logs everyone out (JWT) or makes stored PII
# unreadable (PII_*), so they are generated once per environment and kept in the secret store.
JWT_SIGNING_KEY=__GENERATE__
JWT_ISSUER=hiv-pension-auth
JWT_AUDIENCE=hiv-pension
PII_ENCRYPTION_KEY=__GENERATE__
PII_HMAC_KEY=__GENERATE__

# ---------------------------------------------------------------- sessions and login policy
ACCESS_TTL_MIN=15
REFRESH_TTL_HOURS=8
SESSION_IDLE_MIN=30
LOGIN_RATE_LIMIT_PER_MIN=10
PASSWORD_MAX_FAILED=5
LOCKOUT_MIN=15
# TOTP for STATE and DISTRICT roles. false is accepted only when APP_ENV=local.
MFA_ENFORCED=false
# log = OTP SMS text goes to the auth-service log (local only). esanchar = real gateway.
SMS_PROVIDER=log
ESANCHAR_URL=

# ---------------------------------------------------------------- imports and exports (data-service)
IMPORT_MAX_FILE_MB=10
IMPORT_MAX_ROWS=100000
IMPORT_STAGE_RETENTION_DAYS=7

# ---------------------------------------------------------------- web (BFF)
SESSION_COOKIE_PREFIX=hp
# false is accepted only when APP_ENV=local (http://localhost has no TLS).
COOKIE_SECURE=false

# ---------------------------------------------------------------- local dev users
# scripts/dev.sh seed creates one user per role with this password. Refused unless APP_ENV=local.
DEV_USER_PASSWORD=__GENERATE__
